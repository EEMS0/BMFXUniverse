# Copy to .env.local for local development, or set these in your host's
# environment settings. Never commit real values.

# ---------------------------------------------------------------------------
# Public site URL (no trailing slash), e.g. https://your-domain.example
# Leave empty until the real domain is known. Used for canonical URLs, the
# sitemap and social-preview (Open Graph) image URLs. Local addresses are
# ignored in production builds.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Enquiry email delivery (Resend — https://resend.com)
# All three are required. Until they are set, the form tells visitors that
# enquiries can't be sent yet, and nothing is sent.
RESEND_API_KEY=
# Sender on a domain you have verified in Resend,
# e.g. BMFX enquiries <enquiries@your-domain.example>
ENQUIRY_FROM_EMAIL=
# Inbox that receives enquiries (comma-separate several addresses)
ENQUIRY_TO_EMAIL=

# ---------------------------------------------------------------------------
# Rate limiting for enquiries (per visitor IP address, per window)
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=3600
# Persistent limiter shared by all server instances (Upstash Redis REST API).
# Strongly recommended on serverless hosts such as Vercel: without it the
# limiter only counts requests inside each short-lived server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Only for the static GitHub Pages preview (set by the workflow, not by hand):
# NEXT_PUBLIC_DEPLOY_TARGET=static-preview
# NEXT_PUBLIC_BASE_PATH=/your-repository-name
